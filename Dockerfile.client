# Dockerfile.client (Mac용 빌더)
FROM rust:1.84

WORKDIR /app

# iced GTK 백엔드에 필요한 패키지 설치
RUN apt-get update && apt-get install -y \
    libgtk-3-dev \
    libwebkit2gtk-4.0-dev \
    libayatana-appindicator3-dev \
    librsvg2-dev \
    build-essential \
    pkg-config \
    curl \
    ca-certificates \
    libssl-dev \
    libclang-dev \
    clang \
    llvm-dev \
    libxcb-shape0-dev \
    libxcb-xfixes0-dev \
    libxkbcommon-dev

# 소스 복사
COPY blockchain-learning-platform/client ./client
WORKDIR /app/client

# 릴리즈 빌드
RUN cargo build --release

# 빌드 결과 복사할 수 있게 설정
CMD ["echo", "Build complete. Binary is in target/release/client"]
