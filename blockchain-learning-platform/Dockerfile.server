# Dockerfile.server

# 1. Rust 기반 이미지 사용
FROM rust:1.84

# 2. 작업 디렉토리 설정
WORKDIR /app

# 3. 의존성 캐싱 최적화: Cargo.toml / Cargo.lock 먼저 복사
COPY blockchain-learning-platform/Cargo.toml Cargo.toml
COPY blockchain-learning-platform/Cargo.lock Cargo.lock

# 4. 빈 src 디렉토리 추가 (빌드 캐시 활용 목적)
RUN mkdir -p server/src
RUN echo "fn main() {}" > server/src/main.rs

# 5. 의존성 다운로드 (캐싱 목적)
RUN cargo build --release || true

# 6. 실제 소스 복사 (이후 변경 시에만 다시 빌드됨)
COPY blockchain-learning-platform/server ./server

# 7. 다시 빌드
WORKDIR /app/server
RUN cargo build --release

# 8. 실행
CMD ["./target/release/server"]
